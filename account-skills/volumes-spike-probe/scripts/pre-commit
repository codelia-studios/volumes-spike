#!/bin/sh
# Volumes spike: proves git's own hooks run in a project thread (the formatting fallback when
# Claude Code hooks aren't available). Leaves a dated line in .spike/git-hook.log; never blocks a commit.
dir="$(git rev-parse --show-toplevel 2>/dev/null)/.spike"
mkdir -p "$dir" 2>/dev/null || exit 0
printf '%s pre-commit ran\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$dir/git-hook.log" 2>/dev/null
exit 0
